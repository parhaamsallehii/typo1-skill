{
  "palette": {
    "red": "#B40023",
    "cream": "#FCF0D6"
  },
  "motion_blur": {
    "comp_enabled": true,
    "all_layers_enabled": true,
    "shutter_angle": 180,
    "shutter_phase": 0,
    "samples_per_frame": 16,
    "adaptive_sample_limit": 128
  },
  "styles": {
    "cream": {
      "fill": "#FCF0D6",
      "shadow": "#B40023"
    },
    "red": {
      "fill": "#B40023",
      "shadow": "#FCF0D6"
    }
  },
  "shadow": {
    "distance": 3,
    "opacity": 1,
    "softness": 0,
    "direction_default": "down",
    "direction_was_specified": false,
    "reference_width": 1080
  },
  "deep_glow": {
    "radius": 1000,
    "exposure": 0.3,
    "blend_mode": "screen",
    "native_plugin_required_for_exact_effect": true
  },
  "texture": {
    "noise": true,
    "halftone": true,
    "anchored_to_text": true,
    "halftone_radius_reference_px": 1.05,
    "dot_pitch_reference_px": 4,
    "texture_strength": 1.25
  },
  "spring": {
    "amp": 0.16,
    "freq": 2.5,
    "decay": 5.5,
    "duration": 1,
    "fade_duration": 0.2,
    "max_offset": 300
  },
  "frame_convention": "ordinal frame 1 = t0; frame 5 = 4/fps; same span reversed on exit",
  "entrance_opacity": {
    "start": 0,
    "arrival": 1,
    "interpolation": "linear"
  },
  "exit_opacity": {
    "start": 1,
    "end": 0,
    "interpolation": "linear"
  },
  "hand_draw": {
    "amount_reference_px": 3.2,
    "frequency_hz": 8,
    "continuous": true,
    "anchored_to_text": true
  }
}
